specs (
  {
    name postcard
    include (
      spec/tracey/src/01-intro.md
      spec/tracey/src/02-atoms.md
      spec/tracey/src/03-composites.md
      spec/tracey/src/04-schemas.md
      spec/tracey/src/05-serde.md
      spec/tracey/src/06-implementation-considerations.md
      spec/tracey/src/07-glossary.md
    )
    impls (
      {
        name postcard
        include (
          source/postcard-core/src/lib.rs
          source/postcard-core/src/de.rs
          source/postcard-core/src/de/api.rs
          source/postcard-core/src/de/flavors.rs
          source/postcard-core/src/ser.rs
          source/postcard-core/src/varint.rs
          source/postcard/src/de/deserializer.rs
          source/postcard/src/ser/serializer.rs
        )
        test_include (
          source/postcard-core/tests/wire.rs
          source/postcard/tests/composites.rs
          source/postcard/tests/schemas.rs
          source/postcard/tests/serde_mapping.rs
        )
      }
    )
  }
  {
    name postcard-schema
    include (
      spec/tracey/schema/01-intro.md
      spec/tracey/schema/02-keys.md
      spec/tracey/schema/99-glossary.md
    )
    impls (
      {
        name postcard-schema
        include (
          source/postcard-schema/src/key/hash.rs
        )
        test_include (
          source/postcard-schema/src/key/hash/tests.rs
        )
      }
    )
  }
)
